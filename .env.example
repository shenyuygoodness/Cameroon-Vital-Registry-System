# Copy this to .env and fill in real values. NEVER commit .env.

# ── Django Core ──
SECRET_KEY=replace-with-output-of-python-manage.py-generate-secret-key
DEBUG=False
ALLOWED_HOSTS=your-domain.cm,www.your-domain.cm

# ── Database ──
# sslmode=require is mandatory in production
DATABASE_URL=postgres://clvrs_user:STRONG_RANDOM_PASSWORD@localhost:5432/clvrs_db?sslmode=require

# ── Encryption Key for National IDs (Fernet AES-256) ──
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CRITICAL: Back this up securely. Losing it makes all encrypted NICs permanently unreadable.
ENCRYPTION_KEY=replace-with-generated-fernet-key

# ── Cookie / Transport Security (must all be True in production with HTTPS) ──
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# ── Trusted Reverse Proxies ──
# Comma-separated list of IP addresses allowed to set X-Forwarded-For.
# Set to your Nginx / load-balancer IP(s). Leave empty if no reverse proxy.
TRUSTED_PROXIES=

# ── Redis (required for rate-limiting to work across workers) ──
REDIS_URL=redis://127.0.0.1:6379/1

# ── Email (SMTP) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=CLVRS Registry <your-email@gmail.com>
