# Landing page & core navbar
msgid "Welcome - CLVRS"
msgstr "Bienvenue - CLVRS"

msgid "Welcome to CLVRS"
msgstr "Bienvenue sur CLVRS"

msgid "The Cameroon Local Vital Registry System."
msgstr "Le Système National d'Enregistrement de l'État Civil du Cameroun."

msgid "A secure, decentralized, and modern infrastructure for civil status registration."
msgstr "Une infrastructure sécurisée, décentralisée et moderne pour l'enregistrement de l'état civil."

msgid "Access Portal"
msgstr "Accéder au Portail"

msgid "Learn More"
msgstr "En savoir plus"

msgid "Bank-Grade Security"
msgstr "Sécurité de Niveau Bancaire"

msgid "Cryptographic encryption for sensitive National ID data and strict role-based jurisdiction access."
msgstr "Chiffrement cryptographique des données sensibles d'identifiant national et accès strict basé sur les rôles de juridiction."

msgid "Decentralized Workflow"
msgstr "Flux de Travail Décentralisé"

msgid "Hospitals declare vital events directly, while local councils review, confirm, and register citizens instantly."
msgstr "Les hôpitaux déclarent directement les événements vitaux, tandis que les conseils municipaux locaux vérifient, confirment et enregistrent les citoyens instantanément."

msgid "Bilingual Certificates"
msgstr "Actes Bilingues"

msgid "Automatically generate beautifully formatted, legally compliant English and French certificates."
msgstr "Génération automatique d'actes magnifiquement mis en page et conformes à la loi, en anglais et en français."

