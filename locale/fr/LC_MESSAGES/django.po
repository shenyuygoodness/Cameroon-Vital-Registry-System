msgid "Bulk Import Citizens"
msgstr "Importation en masse des citoyens"

msgid "Back to Citizens"
msgstr "Retour aux citoyens"

msgid "Bulk Citizen Upload (Excel / CSV)"
msgstr "Importation en masse des citoyens (Excel / CSV)"

msgid "Import citizen rosters securely. Database actions are atomic (all-or-nothing)."
msgstr "Importez des listes de citoyens en toute sécurité. Les actions de base de données sont atomiques (tout ou rien)."

msgid "Step 1: Download Template"
msgstr "Étape 1 : Télécharger le modèle"

msgid "Please download our standardized Excel template first to ensure the columns match CLVRS system schemas exactly."
msgstr "Veuillez d'abord télécharger notre modèle Excel standardisé pour vous assurer que les colonnes correspondent exactement aux schémas du système CLVRS."

msgid "Download Excel Template (.xlsx)"
msgstr "Télécharger le modèle Excel (.xlsx)"

msgid "Required Columns & Constraints:"
msgstr "Colonnes obligatoires et contraintes :"

msgid "Citizen names."
msgstr "Noms des citoyens."

msgid "Date of birth (Format: YYYY-MM-DD)."
msgstr "Date de naissance (Format : AAAA-MM-JJ)."

msgid "Must be M or F (or Male/Female)."
msgstr "Doit être M ou F (ou Masculin/Féminin)."

msgid "Required for citizens age 18 and above. Must be blank for under-18. Length 9-20 characters."
msgstr "Obligatoire pour les citoyens de 18 ans et plus. Doit être vide pour les moins de 18 ans. Longueur 9 à 20 caractères."

msgid "If specified, the parent must already exist in the database (NIC hash exact lookup)."
msgstr "Si spécifié, le parent doit déjà exister dans la base de données (recherche exacte par hachage CNI)."

msgid "Step 2: Upload File"
msgstr "Étape 2 : Télécharger le fichier"

msgid "Select Subdivision Council"
msgstr "Sélectionner la commune"

msgid "Choose Subdivision"
msgstr "Choisir l'arrondissement"

msgid "Choose Excel or CSV file"
msgstr "Choisir un fichier Excel ou CSV"

msgid "Upload and Process"
msgstr "Télécharger et traiter"

msgid "Import Validation Errors Detected"
msgstr "Erreurs de validation d'importation détectées"

msgid "The transaction was rolled back. No citizens were added to the database. Fix these errors in your file and try again."
msgstr "La transaction a été annulée. Aucun citoyen n'a été ajouté à la base de données. Corrigez ces erreurs dans votre fichier et réessayez."

msgid "Validation Issue / Failure Message"
msgstr "Problème de validation / Message d'erreur"

